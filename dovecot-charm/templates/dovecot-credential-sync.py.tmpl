#!/usr/bin/python3
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, {{ module_dir | tojson }})

from credentials import CACHED_SOURCE_EXIT_CODE, CredentialError, sync_credentials

try:
    result = sync_credentials(
        source_path=Path({{ source_path | tojson }}) if {{ source_path | tojson }} else None,
        static_users={{ static_users | tojson }},
        cache_path=Path({{ cache_path | tojson }}),
        effective_path=Path({{ effective_path | tojson }}),
    )
except (CredentialError, OSError, subprocess.CalledProcessError) as exc:
    print(f"Credential synchronization failed: {exc}", file=sys.stderr)
    raise SystemExit(2)

if result.using_cached_external_users:
    print(
        "Credential source is unavailable or invalid; retained last valid credentials",
        file=sys.stderr,
    )
    raise SystemExit(CACHED_SOURCE_EXIT_CODE)
